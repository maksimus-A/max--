fn tak(int x, int y, int z): int {
    // 63,609 function calls?!?!
    if (y < x) {
        // This is the torture test.
        // The results of the first two tak() calls MUST be preserved
        // while the third tak() call runs. 
        // Then all three results are passed to a fourth tak() call.
        return tak( 
            tak(x - 1, y, z), 
            tak(y - 1, z, x), 
            tak(z - 1, x, y)
        );
    } else {
        return z;
    }
}

fn main(): int {
    // tak(18, 12, 6) should return 7.
    // This looks simple, but it will execute thousands of calls 
    // and push registers to the stack heavily.
    return tak(18, 12, 6);
}
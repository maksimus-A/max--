
fn main(): int {
    int x = 1;
    int z = 2;
    if (x == 1) {
        int y = 2;
        y = x + 1 - 2 * x;
        if (y < 2) {
            z = 3;
        }
        else {
            int a = 4;
            z = z + 52;
            if (a) {
                z = z + x;
                z = z * 3 + y;
            }
        }

        x = x + 1;
    }
    else {
        x = 2;
    }
    print(z);
    return 0;
}

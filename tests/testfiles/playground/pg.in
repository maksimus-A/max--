fn add(int x, int y): int {
    return x + y;
}

fn inc(int x): int {
    return x+1;
}

fn one(): int {
    return 1;
}

fn fake() {

}

fn retTest(): int {
    int x = 1;
    int y = 2;
    if (x == 1) {
        return x;
    }
    
    x = x + 1;
    return x;
}

fn main(): int {
    int x = 1;
    int y = 2;

    // Void function tests
    fake();
    retTest();

    // Nested function call tests
    int z = add(x, y) + add(inc(inc(x)), one()) * 2;

    return z;
}


// Recursive function call test.
fn sumUpToN(int n): int {
    if (n == 1) {return 1;}

    return n + sumUpToN(n-1);
}

// weird function test (testing successor/CFG building from blocks.)
fn weird1(int n): int {
    int i = 0;
    int acc = 0;

    while (i < n) {
        if (i == 2) {
            if (n == 5) { return 111; }
            else { return 112; }
        } else {
            if (i == 3) { return 113; }
        }

        acc = acc + 1;
        i = i + 1;
    }

    return acc;
}

fn main(): int {
    int x = 1;
    int y = 2;

    // Void function tests
    fake();
    //retTest();

    // Nested function call tests
    int z = add(x, y) + add(inc(inc(x)), one()) * 2;

    return z;
}


fn main(): int {
    int x = 2;
    int y = 2;
    if (x >= y) {
        if (y <= x) {
            x = 4;
        }
        else {x = 5;}
    }
    print(test(x * x));
    return 0;
}
// Should return 3;

fn test(int n): int {
    int a = 0;
    while (a <= n) {
        a = a + 1;
    }
    return a;
}

